{
  "name": "itzgbedrock-server-manager",
  "version": "1.0.0",
  "description": "Minecraft Bedrock Server Manager with Docker support using itzg/bedrock image",
  "main": "server.js",
  "scripts": {
    "start": "npm run build:css:prod && npm run copy-assets && pm2 start ecosystem.config.js --env production",
    "dev": "nodemon server.js",
    "setup": "node setup-websocket.js",
    "build:css": "tailwindcss -i ./public/styles.css -o ./public/output.css --watch",
    "build:css:prod": "tailwindcss -i ./public/styles.css -o ./public/output.css --minify",
    "copy-assets": "node -e \"const fs = require('fs-extra'); fs.copySync('node_modules/sweetalert2/dist', 'public', { overwrite: true });\"",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "fs-extra": "^11.4.1",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pm2": "^7.0.4",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.28",
    "autoprefixer": "^10.6.1"
  }
}
